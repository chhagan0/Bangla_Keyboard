<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/emoji_icon"
        android:layout_marginHorizontal="2dp"
        android:contentDescription="Menu Item 1" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/theme_icon"
        android:layout_marginHorizontal="2dp"

        android:contentDescription="Menu Item 2" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_settings_black_24dp"
        android:layout_marginHorizontal="2dp"

        android:contentDescription="Menu Item 3"
        app:tint="@color/newbtn_text_color" />
</LinearLayout>
